# Contact-form backend (server.js)
EMAIL_USER=
EMAIL_PASS=
CONTACT_RECIPIENT=
PORT=5000

# Frontend (Create React App — must be prefixed REACT_APP_)
REACT_APP_MAILCHIMP_URL=
REACT_APP_MAILCHIMP_U=
