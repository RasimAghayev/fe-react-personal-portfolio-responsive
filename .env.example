# Contact-form backend (server.js)
EMAIL_USER=
EMAIL_PASS=
CONTACT_RECIPIENT=
PORT=5000

# Docker-only, non-secret: host port docker-compose publishes the server on.
# Defaults to 20040 (this repo's reserved block is 20040-20049). Not read by
# server.js itself.
HOST_PORT=20040

# Frontend (Create React App — must be prefixed REACT_APP_)
REACT_APP_MAILCHIMP_URL=
REACT_APP_MAILCHIMP_U=
REACT_APP_MAILCHIMP_ID=
# Base URL of the server.js contact-form backend. Defaults to
# http://localhost:5000 if unset (local dev only) — must be set to a
# real deployed URL in any non-local environment.
REACT_APP_API_URL=
